<?xml version="1.0" encoding="utf-8"?>
<!-- Filled ink when auto is on, outlined when the intensity is manual. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ink_muted">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="@color/accent" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="@color/ink_muted" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
