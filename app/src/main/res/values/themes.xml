<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always light: the app itself is the paper the filter imitates. -->
    <style name="Theme.Carta" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
    </style>

    <!-- Implicit parent of the Carta.* styles below. -->
    <style name="Carta" />

    <style name="Carta.Title">
        <item name="android:fontFamily">@font/literata</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Carta.Body">
        <item name="android:fontFamily">@font/literata</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Carta.Overline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Carta.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/hairline</item>
    </style>
</resources>
