<?xml version="1.0" encoding="utf-8"?>
<!-- Ink page when Carta is on; the accent color when off, inviting a tap. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/on_accent_muted">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <corners android:radius="28dp" />
                    <solid android:color="@color/ink" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="28dp" />
                    <solid android:color="@color/accent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
